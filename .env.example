# Local dev needs none of this - it falls back to SQLite and logs email
# to the console instead of sending it.

# Set by Railway automatically when you attach a Postgres database.
DATABASE_URL=

# Email relay. Without a key, messages are logged, not sent.
RESEND_API_KEY=
MAIL_FROM=hello@ihavenoideawhatidoanymore.com

# Used in emails and share links. Set this in production.
SITE_URL=https://ihavenoideawhatidoanymore.com
